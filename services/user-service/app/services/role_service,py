from sqlalchemy.orm import Session
from sqlalchemy import and_
from fastapi import HTTPException, status
from app.models.user import Role, User
from app.schemas.role import RoleCreate, RoleUpdate
from typing import List, Optional
import logging

logger = logging.getLogger(__name__)

class RoleService:
    
    @staticmethod
    def get_role_by_id(db: Session, role_id: int) -> Optional[Role]:
        """Get role by ID"""
        return db.query(Role).filter(Role.id == role_id).first()
    
    @staticmethod
    def get_role_by_name(db: Session, role_name: str) -> Optional[Role]:
        """Get role by name"""
        return db.query(Role).filter(Role.roleName == role_name).first()
    
    @staticmethod
    def get_all_roles(db: Session, skip: int = 0, limit: int = 100) -> List[Role]:
        """Get all roles with pagination"""
        return db.query(Role).offset(skip).limit(limit).all()
    
    @staticmethod
    def create_role(db: Session, role_data: RoleCreate) -> Role:
        """Create a new role"""
        # Check if role with same name exists
        existing_role = RoleService.get_role_by_name(db, role_data.roleName)
        if existing_role:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Role with name '{role_data.roleName}' already exists"
            )
        
        # Create new role
        new_role = Role(**role_data.model_dump())
        db.add(new_role)
        db.commit()
        db.refresh(new_role)
        
        logger.info(f"Created new role: {new_role.roleName} (ID: {new_role.id})")
        return new_role
    
    @staticmethod
    def update_role(db: Session, role_id: int, role_data: RoleUpdate) -> Optional[Role]:
        """Update an existing role"""
        role = RoleService.get_role_by_id(db, role_id)
        if not role:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Role with ID {role_id} not found"
            )
        
        # Update fields
        update_data = role_data.model_dump(exclude_unset=True)
        for field, value in update_data.items():
            setattr(role, field, value)
        
        role.updatedAt = db.func.now()
        db.commit()
        db.refresh(role)
        
        logger.info(f"Updated role: {role.roleName} (ID: {role.id})")
        return role
    
    @staticmethod
    def update_role_permission(db: Session, role_id: int, permission_name: str, value: bool) -> bool:
        """Update a specific permission for a role"""
        role = RoleService.get_role_by_id(db, role_id)
        if not role:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Role with ID {role_id} not found"
            )
        
        # Check if permission exists
        if not hasattr(role, permission_name):
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Permission '{permission_name}' does not exist"
            )
        
        setattr(role, permission_name, value)
        role.updatedAt = db.func.now()
        db.commit()
        
        logger.info(f"Updated permission {permission_name}={value} for role {role.roleName}")
        return True
    
    @staticmethod
    def update_rate_limit(db: Session, role_id: int, new_rate_limit: int) -> bool:
        """Update rate limit for a role"""
        role = RoleService.get_role_by_id(db, role_id)
        if not role:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Role with ID {role_id} not found"
            )
        
        if new_rate_limit <= 0:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail="Rate limit must be greater than 0"
            )
        
        role.rateLimit = new_rate_limit
        role.updatedAt = db.func.now()
        db.commit()
        
        logger.info(f"Updated rate limit for role {role.roleName} to {new_rate_limit}")
        return True
    
    @staticmethod
    def delete_role(db: Session, role_id: int) -> bool:
        """Delete a role (only if no users are assigned)"""
        role = RoleService.get_role_by_id(db, role_id)
        if not role:
            raise HTTPException(
                status_code=status.HTTP_404_NOT_FOUND,
                detail=f"Role with ID {role_id} not found"
            )
        
        # Check if users are assigned to this role
        user_count = db.query(User).filter(User.roleId == role_id).count()
        if user_count > 0:
            raise HTTPException(
                status_code=status.HTTP_400_BAD_REQUEST,
                detail=f"Cannot delete role with {user_count} assigned users"
            )
        
        db.delete(role)
        db.commit()
        
        logger.info(f"Deleted role: {role.roleName} (ID: {role.id})")
        return True
    
    @staticmethod
    def get_role_with_user_count(db: Session, role_id: int) -> dict:
        """Get role with user count"""
        role = RoleService.get_role_by_id(db, role_id)
        if not role:
            return None
        
        user_count = db.query(User).filter(User.roleId == role_id).count()
        
        return {
            "role": role,
            "user_count": user_count
        }